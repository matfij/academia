{
  "manifest_version": 3,
  "name": "Mist Helper",
  "description": "Utility tool for repetitive tasks",
  "version": "1.3.2",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mist Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["scripting", "activeTab", "tabs"],
  "host_permissions": ["https://mistwood.pl/*"],
  "content_scripts": [
    {
      "js": ["src/main.js"],
      "matches": ["https://mistwood.pl/*"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/index.html",
        "src/index.css",
        "src/utils.js",
        "src/stock-prices.js",
        "src/handlers/*"
      ],
      "matches": ["https://mistwood.pl/*"]
    }
  ]
}
